      "name": "Basic LLM Chain1"
    },
    {
      "parameters": {
        "jsCode": "let positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\nfor (const item of items) {\n  const s = item.json.Sentiment;\n\n  if (s === \"Positive\") positive++;\n  else if (s === \"Negative\") negative++;\n  else neutral++;\n}\n\nconst total = positive + negative + neutral;\n\nreturn [{\n  json: {\n    total,\n    positive,\n    negative,\n    neutral,\n    persenPositif: ((positive / total) * 100).toFixed(1),\n    persenNegative: ((negative / total) * 100).toFixed(1),\n    persenNeutral: ((neutral / total) * 100).toFixed(1)\n  }\n}];"
      },
